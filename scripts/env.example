# HKU 登录凭证
# 复制此文件为 .env 并填入你的信息:
#   cp scripts/env.example .env

HKU_USERNAME=your_uid_here
HKU_PASSWORD=your_password_here

# 可选: 默认课程前缀 (默认: COMP)
# DEFAULT_PREFIX=COMP

# 可选: 代理设置
# HTTP_PROXY=http://proxy.hku.hk:8080
# HTTPS_PROXY=http://proxy.hku.hk:8080

# Supabase 数据库上传 / 检索 API
# 先在 Supabase SQL Editor 运行: npm run db:schema
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 用户登录也复用 Supabase service-role 后端连接。
# 如果只添加登录表，可在 Supabase SQL Editor 单独运行 db/add-auth.sql。
